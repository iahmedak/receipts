  "notes": [
    {
      "id": "note-auth0-runbook",
      "title": "Authentication runbook",
      "body": "Our authentication stack uses Auth0. To rotate the signing key, open the Auth0 dashboard, create a new signing key, and deploy it to the auth service. The runbook covers login, logout, MFA, and the Auth0 management API.",
