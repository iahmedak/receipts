      "records": "auth-auth0-2025"
    },
    {
      "id": "note-vector-architecture",
      "title": "Vector search architecture",
      "body": "Embeddings are stored in Postgres using pgvector. The index is rebuilt nightly, and the retrieval service queries the embeddings table with cosine distance. This document covers the pgvector schema and the rebuild job.",
      "created_at": "2025-07-01",
      "canonical": true,
      "mentions": [
        "vector"
      ],
      "records": "vector-pgvector-2025"
    },
    {
      "id": "note-deploy-guide",
      "title": "Deployment guide",
      "body": "Production deployments run on Fly.io. Use fly deploy from the main branch, then check the Fly.io dashboard for health checks. This guide covers regions, secrets, and rollbacks.",
      "created_at": "2025-03-01",
      "canonical": true,
      "mentions": [
        "deploy"
      ],
      "records": "deploy-fly-2025"
    },
    {
